[Unit]
Description=CRM Globalita (PocketBase + interfaz)
After=network.target

[Service]
Type=simple
User=crm
Group=crm
WorkingDirectory=/opt/crm-globalita

# Escucha SOLO en localhost: quien atiende desde afuera es nginx, que ya tiene
# los puertos 80 y 443 sirviendo bitacorapersonal.online. Que PocketBase no se
# asome a internet es ademas mas seguro: no hay forma de entrarle por el 8090.
# APP_URL es lo que va adentro del enlace del correo de alta (§6.7). Sin
# esto el correo saldria con un enlace a ningun lado, asi que el endpoint de
# invitar corta antes de crear a nadie y lo dice.
Environment=APP_URL=https://crm.globalita.tech
Environment=MAIL_DESDE=crm@globalita.tech

# Las credenciales de Google (paso 4.6). NO van aca: este archivo esta en el
# repo, que es publico, y un client_secret que estuvo en un commit hay que
# rotarlo aunque despues se borre. Van en /etc/crm-globalita.env con chmod 600.
#
# El guion adelante hace que systemd NO falle si el archivo no existe: sin
# Google configurado el CRM arranca igual y la pantalla dice "sin configurar".
EnvironmentFile=-/etc/crm-globalita.env

# --hooksDir NO estaba y sin el los hooks no cargan: ni el alta por correo, ni
# la sincronizacion con Calendar, ni el barrido de retencion. En desarrollo se
# pasaba a mano y en produccion faltaba, asi que era una diferencia silenciosa
# entre las dos.
ExecStart=/opt/crm-globalita/pocketbase serve \
  --dir=/opt/crm-globalita/pb_data \
  --publicDir=/opt/crm-globalita/pb_public \
  --migrationsDir=/opt/crm-globalita/pb_migrations \
  --hooksDir=/opt/crm-globalita/pb_hooks \
  --http=127.0.0.1:8090

Restart=always
RestartSec=5

# Endurecimiento: el proceso solo puede escribir en su propio directorio.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/crm-globalita

LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
